{
  "manifest_version": 3,
  "name": "Quick Note",
  "version": "1.0.1",
  "description": "A simple, fast notepad browser extension with markdown support.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "Quick Note"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "markdown-it.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
